# Override these defaults with environment secrets for deployment.
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=00000000
# Set the exact HTTPS origin when TLS terminates at a trusted reverse proxy.
MUSASHI_PUBLIC_ORIGIN=
# Compose defaults to * so browser access from network nodes works; override to restrict origins.
MUSASHI_ALLOWED_ORIGINS=*
MUSASHI_BIND=127.0.0.1
MUSASHI_PORT=8080
MUSASHI_DATA_DIR=./data
MUSASHI_WEB_BIND=0.0.0.0

# Local Compose-only destination services. Change these before first startup
# if you need custom dev credentials; existing named volumes keep initialized values.
DEV_MQTT_USER=musashi
DEV_MQTT_PASSWORD=dev-mqtt-password
DEV_MQTT_PORT=1883
DEV_POSTGRES_DB=musashi_dev
DEV_POSTGRES_USER=musashi
DEV_POSTGRES_PASSWORD=dev-postgres-password
DEV_POSTGRES_PORT=5432
DEV_INFLUX_USER=musashi
DEV_INFLUX_PASSWORD=dev-influx-password
DEV_INFLUX_TOKEN=dev-influx-token-change-me
DEV_INFLUX_ORG=musashi-dev
DEV_INFLUX_BUCKET=musashi-dev
DEV_INFLUX_PORT=8086
