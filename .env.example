# Override these defaults with environment secrets for deployment.
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=00000000
# Set the exact HTTPS origin when TLS terminates at a trusted reverse proxy.
MUSASHI_PUBLIC_ORIGIN=
# Optional comma-separated exact origins. Plain HTTP is allowed only for localhost or private IPs.
MUSASHI_ALLOWED_ORIGINS=
MUSASHI_BIND=127.0.0.1
MUSASHI_PORT=8080
MUSASHI_DATA_DIR=./data
MUSASHI_WEB_BIND=127.0.0.1
